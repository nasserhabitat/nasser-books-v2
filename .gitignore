# Google Drive pointer files are not the underlying documents.
*.gdoc

# Temporary Microsoft Office lock files.
~$*

# Local operating-system metadata.
Thumbs.db
Desktop.ini

# Generated Word HTML book exports are not published; index.html pages stay tracked.
/books/**/content.htm
/books/**/content.html

# Book binaries stay on Google Drive; GitHub keeps text search files and pages.
/books/**/*.docx
/books/**/*.pdf

# Local migration inventories include source paths; they are not site resources.
__pycache__/
/scripts/drive-new-books.json
/scripts/new-books-plan.json
/scripts/updated-archive-review.json
/scripts/drive-resource-audit.json
/scripts/pending-drive-review.json
/scripts/drive-audit-summary.json
/scripts/monthly-sync-local-inventory.json
/scripts/monthly-sync-cloud-inventory.json
/scripts/monthly-sync-plan.json
/scripts/monthly-sync-legacy-folders.json
